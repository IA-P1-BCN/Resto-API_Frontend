# Copia este fichero como .env y ajusta los valores. NUNCA subas el .env al repo.

# URL de la API (local o Render)
VITE_API_URL=http://localhost:8000

# Modo simulado: login con usuarios de prueba sin llamar a la API (true / false).
# Útil para trabajar sin la API levantada. En Vercel debe ser false.
VITE_USE_MOCK=false
